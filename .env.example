# Copy to .env for Docker Compose. Never commit .env.
DEBUG=0
SECRET_KEY=replace-with-a-random-secret-of-at-least-50-characters
DOMAIN=events.example.ru
ALLOWED_HOSTS=events.example.ru,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://events.example.ru
PUBLIC_BASE_URL=https://events.example.ru
TIME_ZONE=Asia/Novosibirsk
POSTGRES_DB=kulisy
POSTGRES_USER=kulisy
POSTGRES_PASSWORD=replace-with-a-unique-database-password
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.ru
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
# For port 465: EMAIL_USE_TLS=0 and EMAIL_USE_SSL=1
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Кулисы <tickets@events.example.ru>
# Private S3-compatible bucket in Russia (optional locally; configure for production).
# S3_ENDPOINT_URL=https://storage.yandexcloud.net
# S3_BUCKET=kulisy-receipts
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION=ru-central1
